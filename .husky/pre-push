BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Rule: feature/*, bugfix/*, hotfix/*, develop, dev, main
if ! echo "$BRANCH_NAME" | grep -Eq '^(feature|bugfix|hotfix)/[a-zA-Z0-9_-]+$|^develop$|^main$'; then
  echo "\033[0;31m[ERROR] Branch name '$BRANCH_NAME' is invalid!\033[0m"
  echo "Branch name must follow convention: feature/<desc>, bugfix/<desc>, hotfix/<desc>, develop, main"
  exit 1
fi